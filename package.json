{
  "name": "rocket-arena",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based 2v2 multiplayer car-ball game (Rocket League-style)",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "tsc -b shared && npm run build -w server && npm run build -w client",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3"
  }
}
